    <SolidColorBrush x:Key="AppButtonDisabledBrush" Color="#37000000" />
    <SolidColorBrush x:Key="AppTextDisabledBrush" Color="#5C000000" />

    <SolidColorBrush x:Key="AppDragDropBackgroundBrush" Color="#f0f0f0" />
    <SolidColorBrush x:Key="AppDragDropBackgroundHoverBrush" Color="#E1F0FD" />
    <SolidColorBrush x:Key="AppDragDropPartialBackgroundBrush" Color="#FFF4CE" />
