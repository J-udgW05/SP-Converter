<ui:FluentWindow x:Class="SPConverter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SP Converter" Height="680" Width="620" MinWidth="520" MinHeight="540"
        WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        Icon="pack://application:,,,/Assets/Icon.ico"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        UseLayoutRounding="True"
        Background="Transparent">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SP Converter" />

        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource AppCardBorderBrush}" Opacity="0.3" Margin="0,0,0,0" Panel.ZIndex="10"/>

        <Grid Grid.Row="2" Margin="24,10,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="HelpToggleButton"
                        Content="{DynamicResource Nav_Help}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OnHelpToggleClick"/>
                <Button x:Name="SettingsToggleButton"
                        Content="{DynamicResource Nav_Settings}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="OnSettingsToggleClick"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="3" Height="1" Fill="{DynamicResource AppCardBorderBrush}" Opacity="0.5"/>

        <Frame Grid.Row="4" x:Name="ContentFrame" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Focusable="False" />

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,24"/>

        <Border Grid.Row="4" x:Name="NotificationToast"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="16,0,16,24" Padding="18,12"
                Background="{DynamicResource AppPopupBrush}"
                BorderBrush="{DynamicResource AppPopupBorderBrush}"
                BorderThickness="1" CornerRadius="8"
                Visibility="Collapsed" Panel.ZIndex="1000">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.15" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" x:Name="NotificationIcon" Symbol="CheckmarkCircle24" FontSize="24" Foreground="{DynamicResource AppAccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0" MaxWidth="360">
                    <TextBlock x:Name="NotificationTitle" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="NotificationMessage" FontSize="12" Opacity="0.8" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="NotificationOpenFolderBtn" Content="{DynamicResource Msg_OpenFolder}" Style="{StaticResource PrimaryButtonStyle}" Padding="14,6" FontSize="12" VerticalAlignment="Center" Click="OnNotificationOpenFolderClick"/>
                <Button Grid.Column="3" Content="✕" Style="{StaticResource SecondaryButtonStyle}" BorderThickness="0" Background="Transparent" Padding="6,4" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnNotificationCloseClick"/>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
