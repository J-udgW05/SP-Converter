<Page x:Class="SPConverter.Views.Pages.HelpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Help"
      Background="Transparent"
      FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Page.Resources>
        <Style x:Key="HelpExpanderStyle" TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="{DynamicResource AppCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="ContentPadding" Value="18,4,18,14" />
        </Style>

        <Style x:Key="HelpHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HelpBodyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="OnPageScrollViewerPreviewMouseWheel">
        <StackPanel Margin="24,16,24,16" MaxWidth="960">
            <TextBlock Text="{DynamicResource Help_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource AppTextBrush}"/>
            <TextBlock Text="{DynamicResource Help_Subtitle}" FontSize="12" Opacity="0.7" Margin="0,0,0,16" Foreground="{DynamicResource AppTextBrush}" TextWrapping="Wrap"/>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" IsExpanded="True" Icon="{ui:SymbolIcon Rocket24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_QuickStart_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_QuickStart_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon ImageMultiple24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Formats_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Formats_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon Options24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Quality_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Quality_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon Color24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Alpha_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Alpha_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon Filmstrip24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_MultiImage_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_MultiImage_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon Image24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Ico_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Ico_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon DocumentPdf24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Pdf_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Pdf_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon FolderArrowRight24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Output_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Output_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon TextBulletListTree24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Subfolders_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Subfolders_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon Delete24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Delete_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Delete_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>

            <ui:CardExpander Style="{StaticResource HelpExpanderStyle}" Icon="{ui:SymbolIcon Settings24}">
                <ui:CardExpander.Header>
                    <TextBlock Text="{DynamicResource Help_Settings_Title}" Style="{StaticResource HelpHeaderStyle}"/>
                </ui:CardExpander.Header>
                <TextBlock Text="{DynamicResource Help_Settings_Body}" Style="{StaticResource HelpBodyStyle}"/>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>
